{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bush 41 Declassified Memcon",
  "type": "object",
  "required": [
    "id",
    "date",
    "type",
    "title",
    "participants",
    "countries",
    "chapter",
    "releaseStatus",
    "naid",
    "catalogUrl",
    "frusVolume",
    "frusTopics",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable local identifier, preferably date plus participant slug."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": ["Memcon", "Telcon"]
    },
    "title": {
      "type": "string"
    },
    "sourceTitle": {
      "type": "string"
    },
    "documentTitle": {
      "type": "string",
      "enum": ["Memorandum of Conversation", "Memorandum of a Telephone Conversation"]
    },
    "subjectLine": {
      "type": "string"
    },
    "dateLine": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string",
      "pattern": "^Source:"
    },
    "provenanceStatus": {
      "type": "string",
      "enum": ["citation-sheet", "catalog-record", "project-only"],
      "description": "Whether the Source line is grounded in a PDF citation/provenance sheet, catalog metadata, or a project-only working copy still requiring reconciliation."
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chapter": {
      "type": "object",
      "required": ["number", "name"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "name": {
          "type": "string",
          "enum": ["United Kingdom", "France", "Italy", "Regional", "Germany Reference"]
        }
      }
    },
    "sortDate": {
      "type": "string",
      "format": "date",
      "description": "Date used for chronological ordering within the assigned chapter."
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["Full", "Partial", "Denied", "Unknown", "Declassified", "Withheld under b(1)"]
    },
    "naid": {
      "type": "string"
    },
    "pdfUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "pageCount": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Number of memorandum or telephone-conversation text pages, excluding provenance sheets and administrative markers."
    },
    "provenancePages": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of non-text provenance pages included in the project PDF."
    },
    "catalogUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "foiaNumber": {
          "type": "string"
        },
        "localIdentifier": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "objectUrl": {
          "type": "string",
          "format": "uri"
        },
        "objectFilename": {
          "type": "string"
        },
        "sourcePages": {
          "type": "string"
        },
        "duplicateSources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "frusVolume": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["id", "title", "url", "status"],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "status": {
              "type": "string"
            }
          }
        }
      ]
    },
    "frusTopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "provenanceNote": {
      "type": "string"
    },
    "provenanceLinks": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "compilerRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disambiguationNote": {
      "type": "string"
    },
    "localOriginalFile": {
      "type": "string"
    }
  }
}
